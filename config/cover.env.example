# Copy to .env.cover at the project root. Keep the real token local.
WECHAT_AI_BRIDGE_KITS_API_KEY=
# Approved stock female IDs. Confirm in the live catalogue before adding an ID.
# 1014961 is Female LoFi in the official quick-start example, not a usability guarantee.
WECHAT_AI_BRIDGE_KITS_FEMALE_VOICE_IDS=1014961
# Exact result download hosts only. These defaults are from official public examples.
# Actual job output may use a different host; verify it before adding that exact host.
WECHAT_AI_BRIDGE_KITS_DOWNLOAD_HOSTS=arpeggi-prod-public.s3.us-west-2.amazonaws.com,arpeggi-prod-public.kitsstorage.com
# Optional absolute path to FFmpeg; blank uses PATH or the portable media extra.
WECHAT_AI_BRIDGE_COVER_FFMPEG=
