# ============================================================
# 通用聊天模型
# ============================================================
# DeepSeek 或其他 OpenAI 兼容接口的 API Key；必填，不要提交。
CHAT_BRIDGE_MODEL_API_KEY=
# 模型名称。
CHAT_BRIDGE_MODEL_NAME=deepseek-flash
# OpenAI 兼容的模型服务地址。
CHAT_BRIDGE_MODEL_BASE_URL=https://api.deepseek.com
# 允许访问的模型主机，逗号分隔；防止配置被改成陌生地址。
CHAT_BRIDGE_ALLOWED_MODEL_HOSTS=api.deepseek.com
# 思考模式：enabled / disabled。
CHAT_BRIDGE_MODEL_THINKING=disabled
# 单次模型请求超时，秒。
CHAT_BRIDGE_MODEL_TIMEOUT_SECONDS=45
# 单次模型输出上限，token。
CHAT_BRIDGE_MODEL_MAX_TOKENS=1200

# ============================================================
# 微信网关与会话
# ============================================================
# 每个会话恢复最近多少条历史，1-200。
CHAT_BRIDGE_HISTORY_CONTEXT_MESSAGES=50
# 微信状态、白名单和聊天历史数据库。
CHAT_BRIDGE_STATE_DB=data/runtime/chat-state.sqlite3
# 微信 native hook 配置路径。
CHAT_BRIDGE_GATEWAY_CONFIG=data/runtime/native-hook/gateway.json
# 群聊参与方式：natural 自然接话 / mentions 只回应 @。
CHAT_BRIDGE_PARTICIPATION_MODE=natural
# 直接 @ 或私聊后的冷却秒数。
CHAT_BRIDGE_COOLDOWN_SECONDS=5
# 自然消息最后一条之后的合并等待秒数，最少 5 秒。
CHAT_BRIDGE_SPONTANEOUS_COOLDOWN_SECONDS=5
# 每群每小时最多模型调用次数。
CHAT_BRIDGE_HOURLY_QUOTA=60
# 微信轮询间隔，秒。
CHAT_BRIDGE_POLL_SECONDS=2
# 人设文件，UTF-8 文本；修改后下一次请求生效。
CHAT_BRIDGE_PROMPT_FILE=config/persona.md
# 可选：直接覆盖人设文本；留空则读取上面的文件。
CHAT_BRIDGE_SYSTEM_PROMPT=

# ============================================================
# 表情包
# ============================================================
# 是否启用表情包发送；关闭后只发文字。
CHAT_BRIDGE_MEMES_ENABLED=true
# 官方表情缓存目录。
CHAT_BRIDGE_MEME_CACHE_DIR=data/memes
# 同一会话两次发表情之间的冷却秒数。
CHAT_BRIDGE_MEME_COOLDOWN_SECONDS=60
# 候选里排除最近用过的多少张，避免连续重复。
CHAT_BRIDGE_MEME_RECENT_COUNT=5
# 是否自动收藏聊天中出现的表情包；默认关闭。
CHAT_BRIDGE_MEME_COLLECT_ENABLED=false
# 是否也收藏私聊图片；关闭后只处理允许的群聊。
CHAT_BRIDGE_MEME_COLLECT_PRIVATE=true
# 每天最多收藏多少张（QQ + 微信合计）。
CHAT_BRIDGE_MEME_COLLECT_MAX_PER_DAY=20
# AI 判断为表情包的最低置信度，0-1。
CHAT_BRIDGE_MEME_COLLECT_MIN_SCORE=0.75
# 回复时是否优先使用本地收藏的表情包。
CHAT_BRIDGE_MEME_LOCAL_FIRST=true
# 本地收藏库目录；QQ/微信共用。
CHAT_BRIDGE_MEME_LIBRARY_DIR=data/memes/library

# ============================================================
# 私聊长期记忆
# ============================================================
# 是否启用私聊长期记忆。
CHAT_BRIDGE_MEMORY_ENABLED=true
# 记忆与摘要数据库。
CHAT_BRIDGE_MEMORY_DB=data/runtime/memory.sqlite3
# 每 N 轮私聊抽取一次记忆；1 表示每轮，3 可降低模型成本。
CHAT_BRIDGE_MEMORY_UPDATE_EVERY=3
# 每 N 轮生成一次较早对话摘要；0 表示关闭。
CHAT_BRIDGE_MEMORY_SUMMARY_EVERY=30
# 记忆后台队列上限；满了丢弃新任务并写日志。
CHAT_BRIDGE_MEMORY_QUEUE_SIZE=64

# ============================================================
# 日志
# ============================================================
# 轮转日志目录；不要写入聊天正文。
CHAT_BRIDGE_LOG_DIR=data/runtime/logs
# 日志级别：DEBUG / INFO / WARNING / ERROR。
CHAT_BRIDGE_LOG_LEVEL=INFO

# ============================================================
# 微信语音、天气、看图
# ============================================================
# 微信语音条开关；默认关闭。
CHAT_BRIDGE_VOICE_ENABLED=false
# Edge TTS 音色。
CHAT_BRIDGE_VOICE_NAME=zh-CN-XiaoxiaoNeural
# 单条语音最大字数。
CHAT_BRIDGE_VOICE_MAX_CHARS=120
# 天气查询开关。
CHAT_BRIDGE_WEATHER_ENABLED=true
# 天气请求超时，秒。
CHAT_BRIDGE_WEATHER_TIMEOUT_SECONDS=5
# 天气缓存秒数；0 表示不缓存。
CHAT_BRIDGE_WEATHER_CACHE_SECONDS=600
# 微信看图开关。
CHAT_BRIDGE_VISION_ENABLED=true
# 发图后多少秒内 @ 机器人仍可看图。
CHAT_BRIDGE_VISION_WINDOW_SECONDS=120

# ============================================================
# QQ / NapCat OneBot 11
# ============================================================
# NapCat 安装目录；start.ps1 用它拉起 NapCat。
NAPCAT_HOME=tools/NapCat.Shell
# NapCat OneBot HTTP API 地址。
QQ_ONEBOT_API_URL=http://127.0.0.1:3000
# NapCat OneBot HTTP token；不是 QQ 密码。
QQ_ONEBOT_TOKEN=
# 本机 webhook 监听地址。
QQ_WEBHOOK_HOST=127.0.0.1
# 本机 webhook 端口。
QQ_WEBHOOK_PORT=8081
# 本机 webhook 路径。
QQ_WEBHOOK_PATH=/onebot
# NapCat 回调签名密钥；HMAC-SHA1。
QQ_WEBHOOK_SECRET=
# 允许的 QQ 群号，逗号分隔。
QQ_ALLOWED_GROUPS=
# 允许私聊的 QQ 号，逗号分隔；用 `qq friends` 查看。
QQ_ALLOWED_PRIVATE_USERS=
# QQ 独立状态库。
QQ_STATE_DB=data/runtime/qq-chat-state.sqlite3
# QQ 群参与方式：natural / mentions。
QQ_PARTICIPATION_MODE=natural
# QQ 直接互动冷却秒数。
QQ_COOLDOWN_SECONDS=5
# QQ 每小时模型调用上限。
QQ_HOURLY_QUOTA=60
# QQ 自然接话合并等待秒数，最少 5 秒。
QQ_SPONTANEOUS_COOLDOWN_SECONDS=5
# QQ 语音条开关。
QQ_VOICE_ENABLED=true
# GPT-SoVITS api_v2 地址；它必须独立运行，不能装进本项目 venv。
QQ_GPT_SOVITS_URL=http://127.0.0.1:9880
# GPT-SoVITS 参考音频路径，必须是 GPT 进程能读到的本机路径。
QQ_GPT_SOVITS_REF_AUDIO=data/voices/example/reference.wav
# 参考音频里实际说出的文字，必须和音频一致。
QQ_GPT_SOVITS_PROMPT_TEXT=
# 参考音频语言。
QQ_GPT_SOVITS_PROMPT_LANG=zh
# 目标合成语言。
QQ_GPT_SOVITS_TEXT_LANG=zh
# GPT-SoVITS 请求超时秒数。
QQ_GPT_SOVITS_TIMEOUT_SECONDS=30
# QQ 语音最大字数。
QQ_VOICE_MAX_CHARS=120
# QQ 看图开关。
QQ_VISION_ENABLED=true
# QQ 发图后多少秒内 @ 仍可看图。
QQ_VISION_WINDOW_SECONDS=120

# ============================================================
# 曲库翻唱
# ============================================================
# 是否启用 QQ 曲库点歌与翻唱。
SINGING_ENABLED=false
# 歌曲目录；支持 mp3/wav/flac/m4a/ogg/opus。
SINGING_MUSIC_DIR=data/music
# true 发完整 MP3；false 只发前 N 秒语音条。
SINGING_SEND_MP3=false
# 语音条截取秒数。
SINGING_VOICE_EXCERPT_SECONDS=30
# 单首翻唱最大时长，秒。
SINGING_MAX_DURATION_SECONDS=600
# 翻唱任务 SQLite 队列。
SINGING_QUEUE_DB=data/runtime/singing.sqlite3
# 翻唱成品缓存目录。
SINGING_OUTPUT_DIR=data/runtime/covers
# RVC 本地目录。
SINGING_RVC_HOME=tools/RVC
# 运行 RVC 的 Python；当前使用 GPT-SoVITS 自带 runtime。
SINGING_RVC_PYTHON=tools/GPT-SoVITS-v2/GPT-SoVITS-v2-240821/runtime/python.exe
# RVC 模型；可写项目相对路径 data/voices/...，也可写绝对路径。
SINGING_RVC_MODEL=data/voices/example/rvc.pth
# Demucs/RVC 的 torch 缓存目录。
SINGING_TORCH_HOME=tools/GPT-SoVITS-v2/GPT-SoVITS-v2-240821/cache/torch
# 变调半音数；男转女常用 +12，女转女先试 0。
SINGING_PITCH=12
