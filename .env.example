# Copy to .env locally. Never commit real credentials or group IDs.
WECHAT_AI_BRIDGE_MODEL_API_KEY=
WECHAT_AI_BRIDGE_MODEL_NAME=deepseek-flash
WECHAT_AI_BRIDGE_MODEL_BASE_URL=https://api.deepseek.com
WECHAT_AI_BRIDGE_ALLOWED_MODEL_HOSTS=api.deepseek.com
WECHAT_AI_BRIDGE_MODEL_THINKING=disabled
WECHAT_AI_BRIDGE_STATE_DB=data/runtime/chat-state.sqlite3
WECHAT_AI_BRIDGE_GATEWAY_CONFIG=data/runtime/native-hook/gateway.json
WECHAT_AI_BRIDGE_PARTICIPATION_MODE=natural
WECHAT_AI_BRIDGE_COOLDOWN_SECONDS=5
WECHAT_AI_BRIDGE_SPONTANEOUS_COOLDOWN_SECONDS=30
WECHAT_AI_BRIDGE_HOURLY_QUOTA=60
WECHAT_AI_BRIDGE_POLL_SECONDS=2
