# Copy to .env locally. Never commit real credentials or group IDs.
WECHAT_AI_BRIDGE_MODEL_API_KEY=
WECHAT_AI_BRIDGE_MODEL_NAME=deepseek-flash
WECHAT_AI_BRIDGE_MODEL_BASE_URL=https://api.deepseek.com
WECHAT_AI_BRIDGE_ALLOWED_MODEL_HOSTS=api.deepseek.com
WECHAT_AI_BRIDGE_MODEL_THINKING=disabled
# Per-request limits. Recoverable failures get at most one quota-counted retry.
WECHAT_AI_BRIDGE_MODEL_TIMEOUT_SECONDS=45
WECHAT_AI_BRIDGE_MODEL_MAX_TOKENS=1200
# Recent persisted turns restored per group; 1-200, no automatic archive deletion.
WECHAT_AI_BRIDGE_HISTORY_CONTEXT_MESSAGES=50
WECHAT_AI_BRIDGE_STATE_DB=data/runtime/chat-state.sqlite3
WECHAT_AI_BRIDGE_GATEWAY_CONFIG=data/runtime/native-hook/gateway.json
WECHAT_AI_BRIDGE_PARTICIPATION_MODE=natural
WECHAT_AI_BRIDGE_COOLDOWN_SECONDS=5
# 自然消息最后一次发言后的合并等待秒数，最少 5 秒。
WECHAT_AI_BRIDGE_SPONTANEOUS_COOLDOWN_SECONDS=5
WECHAT_AI_BRIDGE_HOURLY_QUOTA=60
WECHAT_AI_BRIDGE_POLL_SECONDS=2
# Edit this UTF-8 text file to customize the AI persona; saved changes apply on the next request.
# An explicitly configured WECHAT_AI_BRIDGE_SYSTEM_PROMPT takes precedence over this file.
WECHAT_AI_BRIDGE_PROMPT_FILE=config/persona.md
# Static scene memes. Run `wechat-ai-bridge memes sync` before restarting the gateway.
WECHAT_AI_BRIDGE_MEMES_ENABLED=true
WECHAT_AI_BRIDGE_MEME_CACHE_DIR=data/runtime/memes
WECHAT_AI_BRIDGE_MEMORY_ENABLED=true
WECHAT_AI_BRIDGE_MEMORY_DB=data/runtime/memory.sqlite3
# Extract long-term facts every N private turns; 1 is every turn, 3 lowers cost.
WECHAT_AI_BRIDGE_MEMORY_UPDATE_EVERY=3
WECHAT_AI_BRIDGE_MEMORY_SUMMARY_EVERY=30
WECHAT_AI_BRIDGE_MEMORY_QUEUE_SIZE=64
# Rotating file log; never write chat text here.
WECHAT_AI_BRIDGE_LOG_DIR=data/runtime/logs
WECHAT_AI_BRIDGE_LOG_LEVEL=INFO
# Per-group image cooldown and recent choices excluded, persisted across restarts.
WECHAT_AI_BRIDGE_MEME_COOLDOWN_SECONDS=60
WECHAT_AI_BRIDGE_MEME_RECENT_COUNT=5
# Experimental automatic voice replies are disabled; restart after changing.
WECHAT_AI_BRIDGE_VOICE_ENABLED=false
# Open-Meteo personal/non-commercial weather; no API key required.
WECHAT_AI_BRIDGE_WEATHER_ENABLED=true
WECHAT_AI_BRIDGE_WEATHER_TIMEOUT_SECONDS=5
WECHAT_AI_BRIDGE_WEATHER_CACHE_SECONDS=600
# Read only a recent image from the same member after an explicit native @ request.
WECHAT_AI_BRIDGE_VISION_ENABLED=true
WECHAT_AI_BRIDGE_VISION_WINDOW_SECONDS=120

# QQ / NapCat OneBot 11. Use a test account and a test group.
# Optional: used by scripts/start.ps1 to launch NapCat.
NAPCAT_HOME=tools/NapCat.Shell
QQ_ONEBOT_API_URL=http://127.0.0.1:3000
QQ_ONEBOT_TOKEN=
QQ_WEBHOOK_HOST=127.0.0.1
QQ_WEBHOOK_PORT=8081
QQ_WEBHOOK_PATH=/onebot
QQ_WEBHOOK_SECRET=
QQ_ALLOWED_GROUPS=
# QQ numbers allowed in one-to-one chat; use `qq friends` to list them.
QQ_ALLOWED_PRIVATE_USERS=
QQ_STATE_DB=data/runtime/qq-chat-state.sqlite3
QQ_PARTICIPATION_MODE=natural
QQ_COOLDOWN_SECONDS=5
QQ_HOURLY_QUOTA=60
QQ_SPONTANEOUS_COOLDOWN_SECONDS=5
QQ_VOICE_ENABLED=true
# GPT-SoVITS api_v2 must run as a separate local service; never put it in this venv.
QQ_GPT_SOVITS_URL=http://127.0.0.1:9880
QQ_GPT_SOVITS_REF_AUDIO=data/runtime/gpt-sovits/reference.wav
QQ_GPT_SOVITS_PROMPT_TEXT=
QQ_GPT_SOVITS_PROMPT_LANG=zh
QQ_GPT_SOVITS_TEXT_LANG=zh
QQ_GPT_SOVITS_TIMEOUT_SECONDS=30
QQ_VOICE_MAX_CHARS=120
QQ_VISION_ENABLED=true
QQ_VISION_WINDOW_SECONDS=120

# Optional local song-library covers (QQ). Keep disabled until RVC is ready.
SINGING_ENABLED=false
SINGING_MUSIC_DIR=data/music
SINGING_SEND_MP3=false
SINGING_VOICE_EXCERPT_SECONDS=30
SINGING_MAX_DURATION_SECONDS=600
SINGING_QUEUE_DB=data/runtime/singing.sqlite3
SINGING_OUTPUT_DIR=data/runtime/covers
SINGING_RVC_HOME=tools/RVC
SINGING_RVC_PYTHON=tools/GPT-SoVITS-v2/GPT-SoVITS-v2-240821/runtime/python.exe
SINGING_RVC_MODEL=assets/weights/da_fei_yu_rvc.pth
SINGING_TORCH_HOME=tools/GPT-SoVITS-v2/GPT-SoVITS-v2-240821/cache/torch
SINGING_PITCH=12
